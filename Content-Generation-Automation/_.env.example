# ==============================================================================
# Content Generation Automation (n8n) - environment template
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ==============================================================================
# SECTION A is read by the workflow at runtime via {{ $env.NAME }}.
# SECTION B is NOT read by n8n: keep it as a reference and paste each value into
# the matching credential in n8n (Credentials > Create). See CREDENTIALS.md.
#
# Self-hosted n8n: make these variables visible to the n8n process/container
# (docker-compose: env_file: .env) and set N8N_BLOCK_ENV_ACCESS_IN_NODE=false.
# n8n Cloud does not expose $env; use n8n Variables and replace $env. with $vars.

# ------------------------------------------------------------------------------
# A) RUNTIME VARIABLES (used by HTTP Request and Google Sheets nodes)
# ------------------------------------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Kie.ai API key (image + video generation). Sent as "Authorization: Bearer <key>"
KIE_API_KEY=your_kie_ai_api_key
# fal.ai API key in the form key_id:key_secret (FFmpeg merge). Sent as "Authorization: Key <key>"
FAL_API_KEY=your_fal_key_id:your_fal_key_secret

# Google Sheet IDs: the long string in the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
# Log of generated scene videos (tab Sheet1)
VIDEO_URLS_SHEET_ID=your_video_urls_sheet_id
# Log of generated carousel images (tab Sheet1)
IMAGE_URLS_SHEET_ID=your_image_urls_sheet_id
# Contacts sheet used by a leftover test branch (tab Sheet1); safe to delete that node
CONTACTS_SHEET_ID=your_contacts_sheet_id

# ------------------------------------------------------------------------------
# B) CREDENTIAL SECRETS (reference only - enter these in the n8n credentials UI)
# ------------------------------------------------------------------------------
# OpenAI (GPT-4.1 prompt-generation agents)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# OpenRouter (Scene Generation agent)
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# Telegram bot token from @BotFather (approval step)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Telegram chat ID that receives approval requests (set on the Telegram node)
TELEGRAM_CHAT_ID=your_chat_id
# Google OAuth2 client (Sheets + YouTube can share one client)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
# Instagram (community node @mookielianhd/n8n-nodes-instagram): see that node's docs
INSTAGRAM_ACCESS_TOKEN=your_instagram_graph_api_token
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id
