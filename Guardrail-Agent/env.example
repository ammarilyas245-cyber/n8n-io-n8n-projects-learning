# Copy to `.env` and fill in. NEVER commit the real `.env`.

# n8n instance settings
GENERIC_TIMEZONE=Asia/Karachi
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# Reference only: this key lives in n8n's credential store (Credentials page),
# not in the workflow. Listed so you know what to prepare.
OPENROUTER_API_KEY=
