# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- n8n runtime ---------------------------------------------------
# Required so nodes can read $env.* expressions
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Karachi

# --- Values read by the workflow via $env.* ------------------------
# Kie.ai API key (image generation: nano-banana-pro)
KIE_API_KEY=
# ID of the "LinkedIn Post" Google Sheet (the long string in its URL)
LINKEDIN_SHEET_ID=
# Telegram chat ID that receives the approval message
TELEGRAM_CHAT_ID=

# --- Reference only: stored in n8n's credential store, not read from here
OPENAI_API_KEY=
TAVILY_API_KEY=
TELEGRAM_BOT_TOKEN=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
LINKEDIN_OAUTH_CLIENT_ID=
LINKEDIN_OAUTH_CLIENT_SECRET=
