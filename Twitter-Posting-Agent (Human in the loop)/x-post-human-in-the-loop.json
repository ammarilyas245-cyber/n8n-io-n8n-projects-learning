    {
      "parameters": {
        "inputText": "={{ $json.data.text }}",
        "categories": {
          "categories": [
            {
              "category": "Approved ",
              "description": "=The post has been reviewed and accepted as is. The human explicitly or implicitly expresses approval indicating that no change are needed.\n\nExample phrases include looks good. \n\"Go ahead and send it\".\n\"This works for me\".\n\"Approved\". \n\"No changes needed\"."
            },
            {
              "category": "Disapproved ",
              "description": "=The post has been reviewed, but the human requests motification before it is sent like tweaks, removing parts, rewording, etc. This could include suggested edits, rewording, or major revision. \n\nExample phrases include:\n\"Can we tweak this part\".\n\"Make it short\". \n\"Change the source to American Kennel CluB\".\n\"More emojis\"."
            }
          ]
        },
        "options": {}
