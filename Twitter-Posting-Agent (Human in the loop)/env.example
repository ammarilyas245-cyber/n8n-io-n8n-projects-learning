# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- n8n runtime ---------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Karachi
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public URL of your n8n (needed for the Gmail send-and-wait link)
WEBHOOK_URL=https://your-n8n-domain.example.com/

# --- Value read by the workflow via $env.* -------------------------
APPROVER_EMAIL=you@example.com

# --- Reference only: stored in n8n's credential store, not read from here
OPENAI_API_KEY=
OPENROUTER_API_KEY=
TAVILY_API_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
