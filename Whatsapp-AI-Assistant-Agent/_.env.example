# ==============================================================================
# WhatsApp AI Assistant (n8n) - environment template
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ==============================================================================
# This file has TWO sections:
#   A) Runtime variables  -> read by the workflows via {{ $env.NAME }}
#   B) Credential secrets -> NOT read by n8n; kept here as a reference / password
#      manager substitute. Paste each value into the matching credential in
#      n8n (Credentials > New). See CREDENTIALS.md for the full mapping.
# ==============================================================================

# ------------------------------------------------------------------------------
# A) RUNTIME VARIABLES (used inside workflow nodes via $env)
#    Self-hosted n8n only: these must be visible to the n8n process/container
#    (docker-compose `env_file: .env`) AND you must set:
#        N8N_BLOCK_ENV_ACCESS_IN_NODE=false
#    n8n Cloud does not expose $env; use n8n Variables ($vars) instead and
#    replace `$env.` with `$vars.` in the imported nodes.
# ------------------------------------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# WhatsApp Cloud API "Phone number ID" (Meta developer console > WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id

# Google Calendar ID the Calendar agent manages (usually your Gmail address)
GOOGLE_CALENDAR_ID=you@example.com

# Employee Records Google Sheet: ID is the long string in the sheet URL
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
EMPLOYEE_SHEET_ID=your_google_sheet_id
EMPLOYEE_SHEET_TAB=Sheet1

# Pinecone index that holds the recipe embeddings
PINECONE_INDEX=your_pinecone_index_name

# ------------------------------------------------------------------------------
# B) CREDENTIAL SECRETS (reference only - enter these in the n8n credentials UI)
# ------------------------------------------------------------------------------

# --- WhatsApp Business Cloud (Meta) ---
# credential: WhatsApp API (use a long-lived System User token)
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# credential: WhatsApp API
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
# credential: WhatsApp OAuth (trigger)
WHATSAPP_APP_CLIENT_ID=your_meta_app_id
# credential: WhatsApp OAuth (trigger)
WHATSAPP_APP_CLIENT_SECRET=your_meta_app_secret

# --- LLM providers ---
# Whisper, vision, TTS, embeddings, GPT-4.1 / 4.1-mini / 5.1
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# orchestrator primary model (Nemotron)
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# fallback + Calendar + Sheets agents
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx
# optional chat model on parent canvas
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Data / search / tools ---
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxx
SERPAPI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx
OPENWEATHERMAP_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# --- Google OAuth2 (one OAuth client can serve Calendar, Sheets and Gmail) ---
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
