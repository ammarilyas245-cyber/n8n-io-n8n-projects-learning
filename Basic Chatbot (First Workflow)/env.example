# =============================================================================
# .env.example  -  copy to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real keys.
#
# NOTE: n8n does not read these automatically into node credentials.
# Use them as a reference when creating credentials in the n8n UI
# (Credentials -> Create), or as environment variables for your n8n instance.
# =============================================================================

# --- n8n instance (self-hosted only) -----------------------------------------
N8N_ENCRYPTION_KEY=

# --- OpenAI (chat models, embeddings, "Message a model") ---------------------
OPENAI_API_KEY=

# --- Groq (Welcome / Terms & Conditions agents) ------------------------------
GROQ_API_KEY=

# --- OpenRouter (Recipes agent, Slack agent) ---------------------------------
OPENROUTER_API_KEY=

# --- SerpApi (Google search tool) --------------------------------------------
SERPAPI_API_KEY=

# --- OpenWeatherMap (weather tool) -------------------------------------------
OPENWEATHERMAP_API_KEY=

# --- Pinecone (vector store for the recipes RAG pipeline) --------------------
PINECONE_API_KEY=
PINECONE_INDEX_NAME=14-recipes-rag-agent

# --- Google OAuth2 (used by BOTH Gmail and Google Drive credentials) ---------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FILE_ID=

# --- Slack (Slack chatbot) ---------------------------------------------------
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_CHANNEL_ID=

# --- Email addresses used in the workflow ------------------------------------
NOTIFICATION_EMAIL=your-email@example.com
SENDER_EMAIL=sender@example.com
SENDER_NAME=

# --- Child workflow ----------------------------------------------------------
# ID of the separate "Weather" workflow called by the Weather tool nodes
WEATHER_CHILD_WORKFLOW_ID=
