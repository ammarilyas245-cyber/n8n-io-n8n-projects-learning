# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- n8n runtime ---------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Karachi
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Public URL of your n8n (also used by the MCP Client nodes)
N8N_BASE_URL=https://your-n8n-domain.example.com
WEBHOOK_URL=https://your-n8n-domain.example.com/

# --- Values read by the workflow via $env.* ------------------------
TELEGRAM_ALLOWED_USERNAME=your_telegram_username
ASSISTANT_USER_NAME=Your Name
EXPENSE_SHEET_ID=
GOOGLE_TASKS_LIST_ID=

# --- Reference only: stored in n8n's credential store, not read from here
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Bearer token you choose to protect the MCP endpoints
MCP_BEARER_TOKEN=
