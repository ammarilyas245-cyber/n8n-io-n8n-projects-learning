# =============================================================================
# .env.example  -  copy to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real keys or tokens.
#
# NOTE: n8n does not read these automatically into node credentials.
# Use them as a reference when creating credentials in the n8n UI
# (Credentials -> Create), or as environment variables for your n8n instance.
# =============================================================================

# --- n8n instance (self-hosted only) -----------------------------------------
N8N_ENCRYPTION_KEY=

# --- OpenAI (GPT-4o writing + gpt-image-1-mini image generation) -------------
OPENAI_API_KEY=

# --- Tavily (live web research) ----------------------------------------------
TAVILY_API_KEY=

# --- LinkedIn OAuth2 ---------------------------------------------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Author ID used in the "Create a post" node (the part after urn:li:person:)
LINKEDIN_PERSON_ID=

# --- Google Drive OAuth2 (temporary public image hosting for Instagram) ------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Instagram (community node @mookielianhd/n8n-nodes-instagram) ------------
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# --- Facebook Graph API (use a PAGE access token, not a user token) ----------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_PAGE_ID=
