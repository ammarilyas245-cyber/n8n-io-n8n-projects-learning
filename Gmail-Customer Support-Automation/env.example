# ---------------------------------------------------------------
# Maison Luxe - Gmail Customer Query Automation
# Copy this file to `.env` and fill in your own values.
# NEVER commit the real `.env` file (it is listed in .gitignore).
# ---------------------------------------------------------------

# --- n8n runtime settings -----------------------------------------
# Required so the workflow can read the $env.* values below inside nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Karachi
# Strongly recommended for self-hosting: encrypts credentials stored in n8n
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Google Sheets (IDs only, taken from the sheet URL) ----------
# https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
INVENTORY_SHEET_ID=your-inventory-sheet-id
ORDERS_SHEET_ID=your-orders-sheet-id

# --- Internal notification recipients -----------------------------
STAFF_COMPLAINT_TEAM_EMAIL=store-ops@example.com
HR_TEAM_EMAIL=hr@example.com
LEGAL_TEAM_EMAIL=legal@example.com
FULFILLMENT_TEAM_EMAIL=fulfillment@example.com

# --- Reference only: secrets that live in n8n's credential store --
# n8n keeps these encrypted in its own database (Credentials page),
# NOT in the workflow JSON. They are listed here so you know what to
# prepare. Do not expect the workflow to read them from this file.
OPENAI_API_KEY=
PINECONE_API_KEY=
NVIDIA_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
