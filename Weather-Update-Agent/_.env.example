# ==============================================================================
# WhatsApp AI Assistant (n8n) - environment template
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ==============================================================================
# n8n does NOT read these keys from .env: they belong in n8n's credential store.
# This file is a local reference so you know which keys to paste into
# n8n > Credentials > Create. See CREDENTIALS.md for the full mapping.
#
# Optional: if you self-host n8n with Docker, you can load this file with
# `env_file: .env` in docker-compose.yml for your own n8n settings.

# --- Weather tool ---
# OpenWeatherMap API key (free tier is enough)
OPENWEATHERMAP_API_KEY=your_openweathermap_key
# OpenAI API key (used for GPT-4.1 in the weather tool)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx

# --- Parent workflow (WhatsApp) ---
# Permanent System User token from Meta Business Suite
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxx
# WhatsApp Business Account ID
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id
# Only needed if you use the OAuth-based WhatsApp trigger credential
WHATSAPP_APP_CLIENT_ID=your_meta_app_id
WHATSAPP_APP_CLIENT_SECRET=your_meta_app_secret
# WhatsApp Phone Number ID (not a secret; identifies the sending number)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
