{
  "name": "Grab Profile Tool [SUB_AGENT] [IMPROVED]",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputData"
      },
      "id": "node-execute-trigger",
      "name": "When Executed by Another Workflow",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [160, 300]
    },
    {
      "parameters": {
        "jsCode": "// Prompt Builder — constructs a clean, structured prompt for GPT\nconst query = $input.first().json?.query?.trim() || '';\nconst sessionId = $input.first().json?.sessionId || 'unknown';\n\nif (!query) {\n  throw new Error('No query provided to sub-agent.');\n}\n\nconst systemPrompt = `You are a LinkedIn profile extraction assistant. \nGiven a search query or LinkedIn URL, extract the key search parameters.\nRespond ONLY with a valid JSON object in this exact format:\n{\n  \"searchQuery\": \"<the refined Google search query to use with SerpAPI>\",\n  \"linkedinUrl\": \"<LinkedIn profile URL if directly provided, otherwise null>\",\n  \"personName\": \"<inferred person name if available, otherwise null>\",\n  \"company\": \"<inferred company if available, otherwise null>\"\n}`;\n\nreturn [{\n  json: {\n    query,\n    sessionId,\n    systemPrompt,\n    userMessage: `Extract search parameters for this LinkedIn query: \"${query}\"`\n  }\n}];"
      },
      "id": "node-prompt-builder",
      "name": "Prompt Builder",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [360, 300]
    },
    {
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": {
          "__rl": true,
          "value": "gpt-4o",
          "mode": "list"
        },
        "messages": {
          "values": [
            {
              "role": "system",
              "content": "={{ $json.systemPrompt }}"
            },
            {
              "role": "user",
              "content": "={{ $json.userMessage }}"
            }
          ]
        },
        "options": {
          "temperature": 0,
          "maxTokens": 300,
          "responseFormat": "json_object"
        }
      },
      "id": "node-gpt-extractor",
      "name": "GPT Extract Parameters",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.4,
      "position": [560, 300],
      "credentials": {
        "openAiApi": {
          "id": "openai-cred",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Parse GPT structured response safely\nconst rawContent = $input.first().json?.message?.content || $input.first().json?.text || '';\n\nlet parsed;\ntry {\n  // Strip any accidental markdown fences\n  const cleaned = rawContent.replace(/```json|```/gi, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  throw new Error(`GPT returned unparseable response: ${rawContent.substring(0, 200)}`);\n}\n\nconst { searchQuery, linkedinUrl, personName, company } = parsed;\n\nif (!searchQuery && !linkedinUrl) {\n  throw new Error('GPT could not extract a usable search query from the input.');\n}\n\n// Build the SerpAPI query — prefer direct URL, fall back to search query\nconst serpQuery = linkedinUrl\n  ? `site:linkedin.com/in \"${searchQuery}\"`\n  : `site:linkedin.com/in ${searchQuery}`;\n\nreturn [{\n  json: {\n    serpQuery,\n    linkedinUrl: linkedinUrl || null,\n    personName: personName || null,\n    company: company || null,\n    originalQuery: $('Prompt Builder').item.json.query,\n    sessionId: $('Prompt Builder').item.json.sessionId\n  }\n}];"
      },
      "id": "node-parse-gpt-response",
      "name": "Parse GPT Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "url": "https://serpapi.com/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpQueryAuth",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "q",
              "value": "={{ $json.serpQuery }}"
            },
            {
              "name": "engine",
              "value": "google"
            },
            {
              "name": "num",
              "value": "5"
            },
            {
              "name": "api_key",
              "value": "={{ $env.SERP_API_KEY }}"
            }
          ]
        },
        "options": {
          "timeout": 15000,
          "retry": {
            "enabled": true,
            "maxRetries": 3,
            "waitBetweenRetries": 2000
          },
          "response": {
            "response": {
              "responseFormat": "json",
              "fullResponse": false
            }
          }
        }
      },
      "id": "node-serp-api",
      "name": "SerpAPI HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [960, 300],
      "credentials": {
        "httpQueryAuth": {
          "id": "serp-api-cred",
          "name": "SerpAPI Key"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Extract and validate LinkedIn profile data from SerpAPI results\nconst results = $input.first().json?.organic_results || [];\nconst meta = $('Parse GPT Response').item.json;\n\nif (!results.length) {\n  return [{\n    json: {\n      success: false,\n      reason: 'No results returned from SerpAPI',\n      originalQuery: meta.originalQuery\n    }\n  }];\n}\n\n// Filter to LinkedIn profile URLs only (not company pages, posts, etc.)\nconst profileResults = results.filter(r => {\n  const url = (r.link || '').toLowerCase();\n  return url.includes('linkedin.com/in/') && !url.includes('/posts') && !url.includes('/detail');\n});\n\nif (!profileResults.length) {\n  return [{\n    json: {\n      success: false,\n      reason: 'SerpAPI returned results but none were LinkedIn profile URLs',\n      rawLinks: results.slice(0, 3).map(r => r.link)\n    }\n  }];\n}\n\nconst top = profileResults[0];\n\n// Clean the LinkedIn URL (remove tracking params)\nlet cleanUrl = top.link || '';\ntry {\n  const u = new URL(cleanUrl);\n  cleanUrl = `${u.origin}${u.pathname}`;\n} catch(_) {}\n\n// Try to extract name from title (e.g. \"John Doe - Software Engineer at Acme | LinkedIn\")\nconst titleParts = (top.title || '').split(' - ');\nconst extractedName = meta.personName || titleParts[0]?.trim() || 'Unknown';\n\n// Extract headline/role\nconst rawHeadline = top.snippet || top.title || '';\nconst headline = rawHeadline.replace(' | LinkedIn', '').trim();\n\nreturn [{\n  json: {\n    success: true,\n    name: extractedName,\n    linkedinUrl: cleanUrl,\n    headline,\n    company: meta.company || null,\n    title: titleParts[1]?.trim() || null,\n    originalQuery: meta.originalQuery,\n    sessionId: meta.sessionId,\n    scrapedAt: new Date().toISOString()\n  }\n}];"
      },
