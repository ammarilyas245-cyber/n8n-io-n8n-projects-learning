# =============================================================================
# .env.example  -  copy to `.env` and fill in your own values.
# `.env` is git-ignored. NEVER commit real keys.
#
# NOTE: n8n does not read these automatically into node credentials.
# Use them as a reference when creating credentials in the n8n UI
# (Credentials -> Create), or as environment variables for your n8n instance.
# =============================================================================

# --- n8n instance (self-hosted only) -----------------------------------------
N8N_ENCRYPTION_KEY=

# --- OpenAI (GPT-4.1 for the script, scene, image-prompt, video-prompt agents)
OPENAI_API_KEY=

# --- Kie.ai (Seedream image generation + Veo 3 video generation) -------------
# Create an n8n "Header Auth" credential:
#   Name:  Authorization
#   Value: Bearer <KIE_API_KEY>
KIE_API_KEY=

# --- Cloudinary (re-hosts generated images + stores character references) ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sheets OAuth2 (content tracking sheet) ---------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID of your "Rydflow Content Data" spreadsheet (the long string in its URL)
GOOGLE_SHEET_ID=
