      "parameters": {
        "jsCode": "const data = $json.data;\n\n// Extract plain text if it's an array (Telegram's response format)\nlet text;\nif (Array.isArray(data.text)) {\n  text = data.text.map(t => t.text || '').join('');\n} else {\n  text = data.text;\n}\n\nreturn [{ json: { ...($json), data: { ...data, text } } }];"
      },
      "type": "n8n-nodes-base.code",
