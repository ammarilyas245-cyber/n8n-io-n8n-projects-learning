    {
      "parameters": {
        "jsCode": "// Get the response from the HTTP Request node\nconst response = $input.first().json;\n\n// The twitterapi.io response contains a 'tweets' array\nconst tweets = response.tweets || [];\n\n// Map each tweet into a separate n8n item with your required fields\nconst items = tweets.map(tweet => {\n  return {\n    json: {\n      id:           tweet.id || tweet.tweet_id || \"\",\n      url:          tweet.url || `https://twitter.com/i/web/status/${tweet.id}`,\n      text:         tweet.text || tweet.full_text || \"\",\n      retweetCount: tweet.retweetCount ?? tweet.retweet_count ?? 0,\n      replyCount:   tweet.replyCount   ?? tweet.reply_count   ?? 0,\n      likeCount:    tweet.likeCount    ?? tweet.like_count    ?? tweet.favorite_count ?? 0,\n      quoteCount:   tweet.quoteCount   ?? tweet.quote_count   ?? 0,\n      viewCount:    tweet.viewCount    ?? tweet.view_count    ?? tweet.views ?? 0,\n      createdAt:    tweet.createdAt    ?? tweet.created_at    ?? \"\",\n    }\n  };\n});\n\nreturn items;"
      },
