# ==============================================================================
# Customer Support Chatbot (n8n) - environment template
# Copy to .env and fill in. NEVER commit .env (it is in .gitignore).
# ==============================================================================
# SECTION A is read by the workflow at runtime via {{ $env.NAME }}.
# SECTION B is NOT read by n8n: keep it as a reference and paste each value into
# the matching credential in n8n (Credentials > Create). See CREDENTIALS.md.
#
# Self-hosted n8n: make these variables visible to the n8n process/container
# (docker-compose: env_file: .env) and set N8N_BLOCK_ENV_ACCESS_IN_NODE=false.
# n8n Cloud does not expose $env; use n8n Variables and replace $env. with $vars.

# ------------------------------------------------------------------------------
# A) RUNTIME VARIABLES (IDs used inside workflow nodes)
# ------------------------------------------------------------------------------
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Pinecone index the support agent READS from (Pinecone Vector Store node)
PINECONE_RETRIEVE_INDEX=your_pinecone_index_name
# Pinecone index the Drive ingestion flow WRITES to (Pinecone Vector Store1 node)
# Normally this must be the SAME index as PINECONE_RETRIEVE_INDEX
PINECONE_INGEST_INDEX=your_pinecone_index_name

# Google Drive folder watched for new knowledge-base files
# https://drive.google.com/drive/folders/<THIS_PART>
DRIVE_FAQ_FOLDER_ID=your_drive_folder_id
# Google Drive file downloaded by the "Download file" node
# https://drive.google.com/file/d/<THIS_PART>/view
DRIVE_PROFILE_FILE_ID=your_drive_file_id

# Gmail label applied to handled emails (create the label in Gmail first).
# The ID looks like Label_123456789; get it from the Gmail node's label dropdown.
GMAIL_LABEL_ID=Label_xxxxxxxxxxxxxxxxxxx

# ------------------------------------------------------------------------------
# B) CREDENTIAL SECRETS (reference only - enter these in the n8n credentials UI)
# ------------------------------------------------------------------------------
# OpenAI: GPT-4.1-mini (agent) + embeddings
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# NVIDIA: Nemotron email classifier
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxx
# Pinecone: vector store
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxx
# Google OAuth2 client (one client can serve Gmail and Drive)
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxx
