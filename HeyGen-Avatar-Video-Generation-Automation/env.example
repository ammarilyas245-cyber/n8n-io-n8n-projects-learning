# Copy to `.env` and fill in. NEVER commit the real `.env`.

# --- n8n runtime ---------------------------------------------------
# Required so the workflow can read $env.* values inside nodes
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
GENERIC_TIMEZONE=Asia/Karachi
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string

# --- Values the workflow reads via $env.* --------------------------
# HeyGen API key (HTTP Request nodes) - https://app.heygen.com/settings?nav=API
HEYGEN_API_KEY=
# Kie.ai API key (Kling avatar branch) - https://kie.ai/api-key
KIE_API_KEY=
# Google Drive folder ID where uploaded avatar images are stored
# (the last part of https://drive.google.com/drive/folders/<ID>)
GOOGLE_DRIVE_FOLDER_ID=

# --- Reference only: stored in n8n's credential store, not read from here
OPENAI_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
